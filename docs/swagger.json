{
    "swagger": "2.0",
    "info": {
        "description": "API for loading XKCD comic titles by comic number range.",
        "title": "XKCD Helper API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/load-comics": {
            "get": {
                "description": "Returns XKCD comics as \"number, title\" strings for the requested range.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "comics"
                ],
                "summary": "Load comics",
                "parameters": [
                    {
                        "type": "integer",
                        "description": "Starting comic number",
                        "name": "from",
                        "in": "query",
                        "required": true
                    },
                    {
                        "type": "integer",
                        "description": "Ending comic number",
                        "name": "to",
                        "in": "query",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Loaded comics",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/dto.Comic"
                            }
                        }
                    },
                    "500": {
                        "description": "Failed to send JSON",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "dto.Comic": {
            "type": "object",
            "properties": {
                "description": {
                    "type": "string"
                },
                "num": {
                    "type": "integer"
                }
            }
        }
    }
}